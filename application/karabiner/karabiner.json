{
    "global": {
        "check_for_updates_on_startup": false,
        "enable_notification_window": false
    },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Enhanced right_cmd",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": { "optional": [ "any" ] }
                                },
                                "to": [ { "key_code": "left_control" } ],
                                "to_if_alone": [
                                    {
                                        "shell_command": "osascript -e 'set bid to \"net.kovidgoyal.kitty\"' -e 'tell application \"System Events\" to set procs to (every process whose bundle identifier is bid)' -e 'if (count of procs) > 0 and frontmost of item 1 of procs then' -e 'tell application \"System Events\" to set visible of item 1 of procs to false' -e 'else' -e 'tell application id bid to activate' -e 'end if'"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "F12 → Cmd+Opt+I in Safari (Dev Tools)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "f12"
                                },
                                "to": [
                                    {
                                        "key_code": "i",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": ["^com\\.apple\\.Safari$"]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Alt+1 toggle Kitty",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "1",
                                    "modifiers": { "mandatory": [ "option" ] }
                                },
                                "to": [
                                    {
                                        "shell_command": "osascript -e 'set bid to \"net.kovidgoyal.kitty\"' -e 'tell application \"System Events\" to set procs to (every process whose bundle identifier is bid)' -e 'if (count of procs) > 0 and frontmost of item 1 of procs then' -e 'tell application \"System Events\" to set visible of item 1 of procs to false' -e 'else' -e 'tell application id bid to activate' -e 'end if'"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Alt+2 toggle Visual Studio Code",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "2",
                                    "modifiers": { "mandatory": [ "option" ] }
                                },
                                "to": [
                                    {
                                        "shell_command": "osascript -e 'set bid to \"com.microsoft.VSCode\"' -e 'tell application \"System Events\" to set procs to (every process whose bundle identifier is bid)' -e 'if (count of procs) > 0 and frontmost of item 1 of procs then' -e 'tell application \"System Events\" to set visible of item 1 of procs to false' -e 'else' -e 'tell application id bid to activate' -e 'end if'"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Alt+3 toggle Microsoft Edge Dev",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "3",
                                    "modifiers": { "mandatory": [ "option" ] }
                                },
                                "to": [
                                    {
                                        "shell_command": "osascript -e 'set bid to \"com.microsoft.edgemac.Dev\"' -e 'tell application \"System Events\" to set procs to (every process whose bundle identifier is bid)' -e 'if (count of procs) > 0 and frontmost of item 1 of procs then' -e 'tell application \"System Events\" to set visible of item 1 of procs to false' -e 'else' -e 'tell application id bid to activate' -e 'end if'"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Alt+4 toggle Obsidian",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "4",
                                    "modifiers": { "mandatory": [ "option" ] }
                                },
                                "to": [
                                    {
                                        "shell_command": "osascript -e 'set bid to \"md.obsidian\"' -e 'tell application \"System Events\" to set procs to (every process whose bundle identifier is bid)' -e 'if (count of procs) > 0 and frontmost of item 1 of procs then' -e 'tell application \"System Events\" to set visible of item 1 of procs to false' -e 'else' -e 'tell application id bid to activate' -e 'end if'"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Enhanced CapsLock",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": [ "any" ] }
                                },
                                "to": [ { "key_code": "left_command" } ],
                                "to_if_alone": [ { "key_code": "escape" } ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}